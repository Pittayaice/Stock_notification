# LINE Developers console → your channel
#   Basic settings tab   → Channel secret
#   Messaging API tab    → Channel access token (long-lived)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# SQLite file for local development.
# Later, for Postgres/Supabase: postgresql+psycopg://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./stock_bot.db

# Cloud database (Neon Postgres) for the deployed bot. Only used when deploying.
PROD_DATABASE_URL=
